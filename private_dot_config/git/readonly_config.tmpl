[alias]
	poh = "push origin HEAD"
	puh = "pull origin HEAD"
	set-upstream = "!git branch --set-upstream-to=origin/`git symbolic-ref --short HEAD`"
	undo-commit = "reset --soft HEAD^"
	unstage = "reset HEAD"

[branch]
	autosetuprebase = "always"

[color]
	ui = true

# Signing is declared here rather than set with `git config --global` at
# provisioning time: this file is readonly_ and chezmoi-owned, so an imperative
# write would be reverted by the next apply.
# The key it names is created by private_dot_ssh's setup-ssh-identity script,
# which runs in the after_ stage -- i.e. after this file is written. Naming a
# not-yet-existing pubkey is inert until the first commit, and by then the same
# apply has generated it.
#
# STUCK? If the key is ever missing -- deleted key, failed script, an apply with
# --exclude=scripts, a machine provisioned before this was added -- then every
# commit fails, rebase and cherry-pick included. Three ways out:
#     git config --global commit.gpgsign false  # works, but the next
#                                               # `chezmoi apply` reverts it
#                                               # with no warning
#     git config --local commit.gpgsign false   # unblock the repo you are in
#     git commit --no-gpg-sign                  # unblock a single commit
# The --global write does succeed despite this file's 444 mode: git writes
# config through a lockfile and rename(), and rename() needs write permission on
# the *directory*, not on the target file. So it is a genuine escape hatch --
# just a temporary one, and one that leaves you unsigned until it silently
# reverts. The durable fix is `chezmoi apply`, which regenerates the key.
# Signing also needs git >= 2.34; setup-ssh-identity warns if it is older.
[commit]
	gpgsign = true

[core]
	autocrlf = "input"
	editor = "vim"
	excludesfile = "/Users/cramer/.gitignore_global"

[diff]
	tool = "bcomp"

[difftool]
	prompt = false

[difftool "bcomp"]
	cmd = "/usr/local/bin/bcomp $LOCAL $REMOTE"
	trustExitCode = true

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[gpg]
	format = "ssh"

# Lets `git log --show-signature` verify locally instead of reporting "No
# principal matched". Regenerated from the pubkey by setup-ssh-identity.
[gpg "ssh"]
	allowedSignersFile = {{ joinPath .chezmoi.homeDir ".ssh" "allowed_signers" | quote }}

[init]
	defaultBranch = "main"

[merge]
	tool = "bcomp"

[mergetool]
	prompt = false

[mergetool "bcomp"]
	cmd = "/usr/local/bin/bcomp $LOCAL $REMOTE $BASE $MERGED"
	trustExitCode = true

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = "current"

# pushInsteadOf, not insteadOf: rewriting fetches too breaks the bootstrap.
# `chezmoi init mjcramer/envious` guesses an https URL and clones it keyless,
# then applies this file -- after which every fetch against that remote is
# rewritten to ssh and `chezmoi update` fails on a machine with no key yet.
# Pushing is the only side that genuinely needs the key.
[url "ssh://git@github.com/"]
	pushInsteadOf = "https://github.com/"

[user]
	email = {{ .email | quote }}
	name = "Michael Cramer"
	# Absolute, not "~/...": git 2.55 expands the tilde here but older gits on
	# the Linux target do not, and the failure is a confusing signing error.
	signingkey = {{ joinPath .chezmoi.homeDir ".ssh" "id_ed25519.pub" | quote }}
