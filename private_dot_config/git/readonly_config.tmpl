[alias]
	poh = "push origin HEAD"
	puh = "pull origin HEAD"
	set-upstream = "!git branch --set-upstream-to=origin/`git symbolic-ref --short HEAD`"
	undo-commit = "reset --soft HEAD^"
	unstage = "reset HEAD"

[branch]
	autosetuprebase = "always"

[color]
	ui = true

[core]
	autocrlf = "input"
	editor = "vim"
	excludesfile = "/Users/cramer/.gitignore_global"

[diff]
	tool = "bcomp"

[difftool]
	prompt = false

[difftool "bcomp"]
	cmd = "/usr/local/bin/bcomp $LOCAL $REMOTE"
	trustExitCode = true

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[init]
	defaultBranch = "main"

[merge]
	tool = "bcomp"

[mergetool]
	prompt = false

[mergetool "bcomp"]
	cmd = "/usr/local/bin/bcomp $LOCAL $REMOTE $BASE $MERGED"
	trustExitCode = true

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = "current"

# pushInsteadOf, not insteadOf: rewriting fetches too breaks the bootstrap.
# `chezmoi init mjcramer/envious` guesses an https URL and clones it keyless,
# then applies this file -- after which every fetch against that remote is
# rewritten to ssh and `chezmoi update` fails on a machine with no key yet.
# Pushing is the only side that genuinely needs the key.
[url "ssh://git@github.com/"]
	pushInsteadOf = "https://github.com/"

[user]
	email = {{ .email | quote }}
	name = "Michael Cramer"
