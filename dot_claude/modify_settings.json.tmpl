def dedupe(seq):
    seen, out = set(), []
    for x in seq:
        if x not in seen:
            seen.add(x)
            out.append(x)
    return out


def merge(cur, want):
    for k, v in want.items():
        if k in ("permissions", "hooks"):
            continue
        cur[k] = v  # enforced

    perms = cur.setdefault("permissions", {})
    for k, v in want["permissions"].items():
        if k in ("allow", "ask", "deny"):
            continue
        perms[k] = v  # e.g. defaultMode, enforced
    for k in ("allow", "ask", "deny"):
        merged = dedupe(want["permissions"].get(k, []) + perms.get(k, []))
        # sorted so the written file stays alphabetical however the union orders things --
        # these lists get looked things up in, not read top to bottom
        perms[k] = sorted(r for r in merged if r not in RETIRED)
    for k in ("allow", "ask"):
        perms[k] = [r for r in perms[k] if r not in perms["deny"]]

    hooks = cur.setdefault("hooks", {})
    for event, matchers in want["hooks"].items():
        have = hooks.setdefault(event, [])
        for m in matchers:
            cmd = m["hooks"][0]["command"]
            present = any(h.get("command") == cmd
                          for existing in have for h in existing.get("hooks", []))
            if not present:
                have.append(m)
    return cur


def main():
    raw = sys.stdin.read()
    try:
        cur = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError as e:
        # never clobber a file we can't parse: pass it through unchanged and complain
        sys.stderr.write(f"modify_settings.json: existing settings.json is not valid JSON ({e}); left unchanged\n")
        sys.stdout.write(raw)
        return 0
    sys.stdout.write(json.dumps(merge(cur, SETTINGS), indent=2) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
