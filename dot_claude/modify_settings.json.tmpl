#!/usr/bin/env python3
# chezmoi modify_ script for ~/.claude/settings.json  (also a chezmoi template: {{ .chezmoi.homeDir }}
# is substituted before it runs, so paths below are per-machine).
#
# chezmoi runs this on every `chezmoi apply`, piping the CURRENT ~/.claude/settings.json on stdin;
# whatever is printed to stdout becomes the new file. Semantics:
#   * scalar / object keys in SETTINGS (model, statusLine, defaultMode, worktree, ...) are enforced —
#     the value here always wins over what is on disk
#   * permission lists are unioned (your rules here + anything Claude Code saved on disk), deduped,
#     sorted, and any rule present in `deny` is removed from `allow`/`ask`
#   * anything listed in RETIRED is stripped from every list, on disk included -- that is the only
#     way to actually delete a rule, since the union would otherwise keep it forever
#   * hooks are added per event unless a hook with the same command is already wired, so hooks
#     Claude Code or you add on disk are kept and re-applies never stack duplicates
#   * anything on disk that this file doesn't mention is left alone
# The merge is idempotent, so `chezmoi diff` is empty after apply. Edit SETTINGS to change things.
import json
import sys

HOME = "{{ .chezmoi.homeDir }}"

# Rules to delete wherever they appear, including entries Claude Code has already written to
# ~/.claude/settings.json. Removing a rule from SETTINGS alone does nothing: the merge unions
# with what is on disk, so a retired rule would survive every apply. List it here instead.
RETIRED = {
    # Notion goes through the claude.ai connector; the local mcp__notion__ server is gone.
    "mcp__notion__notion-create-pages",
    "mcp__notion__notion-fetch",
    "mcp__notion__notion-search",
    "mcp__notion__notion-update-page",
    # Stale allow from the Linux box, left behind by the union. Edit({HOME}/.claude/**) is
    # denied on each machine, and this entry quietly re-permitted it there.
    "Edit(/home/mcramer/.claude/**)",
}

