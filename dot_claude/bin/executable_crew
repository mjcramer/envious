#!/usr/bin/env python3
"""
crew — git workspaces for Claude Code subagents.

Each run of an agent that has `isolation: worktree` in its frontmatter gets its own git
worktree next to the main checkout, cut from the branch you are working on and named
after the agent and the task it was given:

    workspace   <repo>.<agent>.<task>      e.g. ~/src/platform.infra-engineer.ci-free-disk
    branch      agent/<agent>/<task>

Claude Code does not say which agent a worktree is for when it asks for one, only a
generated id. crew finds out by reading the launch that is in flight from the session
transcript. The transcript is written behind the conversation, so crew keeps re-reading
it for a moment (LAUNCH_WAIT) before giving up. When it cannot find the launch, the
workspace starts out as  <repo>.agent-<id>  and is given its proper name when the agent
stops, which is also when a wrong guess is put right. Workspaces are never removed.

Whatever the agent leaves uncommitted is committed when it stops, as  [<agent>] <summary>.

Some agents (see IN_CHECKOUT_AGENTS) deliberately have no worktree and work directly in
the human's checkout. They get no branch, but what they leave is still committed when they
stop, so there is a boundary to find with  git log -F --grep '[<agent>]'.

Hook entry points (wired in ~/.claude/settings.json):
  crew hook-create   WorktreeCreate  -> creates the workspace, prints its path
  crew hook-remove   WorktreeRemove  -> keeps the workspace (prunes an empty branch)
  crew hook-stop     SubagentStop    -> commits leftovers, settles the workspace's names

CLI (run from anywhere inside the repo or a workspace):
  crew list                      workspaces, their branches, ahead/behind
  crew path <agent>              print the workspace path:  cd "$(crew path craft-engineer)"
  crew diff <agent> [branch]     what the workspace would bring in, against the branch it
                                 was cut from, or against the one you name
  crew clean [<agent>]           remove the workspaces that hold nothing of their own: every
                                 commit is on another branch too, and nothing is uncommitted
  crew clean --all [<agent>]     remove them all, unmerged and uncommitted work included

<agent> means that agent's most recent workspace; `crew list` shows the earlier ones.

`crew clean` is for you, not for agents: it shows what it would remove and what would be
lost, and removes nothing until you answer yes at a terminal. Without a terminal it only
shows the list. It removes the workspace and its agent/ branch; a branch of any other
name is left alone.

Override the workspace parent directory with AGENT_WS_ROOT (default: sibling of the repo,
falling back to ~/.claude/workspaces if the sibling location is not writable).

To see what a hook was actually given, create the directory ~/.claude/crew-debug (or
point CREW_DEBUG_DIR at one). While it exists, every hook run writes a file there with
the payload it received and the log lines it printed. Remove the directory to stop. The
files hold whatever the payload held, which at SubagentStop includes the agent's last
message, so treat them as you would the transcript.
"""
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from contextlib import contextmanager
from datetime import datetime
from pathlib import Path

BRANCH_PREFIX = "agent/"
GENERATED_NAME = re.compile(r"agent-[0-9a-f]{8,}")     # what Claude Code calls a subagent's worktree
STAMP = re.compile(r"\d{8}-\d{4}(-\d+)?")              # a branch nobody has named yet
TRANSCRIPT_TAIL = 4 * 1024 * 1024                      # a launch in flight is near the end
LAUNCH_WAIT = 2.0                                      # seconds to keep re-reading it for the launch
LAUNCH_POLL = 0.1
DEBUG_DIR = Path.home() / ".claude" / "crew-debug"     # hook payload capture, on while it exists

# Agents that deliberately work in the human's checkout instead of their own worktree.
# They have no branch; their finish is committed in place so there is a readable boundary.
IN_CHECKOUT_AGENTS = {"spike-engineer"}


# ----------------------------------------------------------------------------- helpers
def log(msg):
    print(f"[crew] {msg}", file=sys.stderr)
    if capture:
        capture.note(msg)


class Capture:
    """One file per hook run: the payload as received, then what crew said about it.

    The payload is written before the hook does anything, so it is on disk even if the
    hook then dies; the file is rewritten with the log lines at the end. Readable by
    the owner only. A failure to write is reported and otherwise ignored: a debugging
    aid must never be what breaks a worktree launch."""

    def __init__(self, directory, hook, payload):
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
        self.path = directory / f"{stamp}-{hook}.json"
        self.record = {"hook": hook, "received": datetime.now().astimezone().isoformat(timespec="milliseconds"),
                       "pid": os.getpid(), "payload": payload, "crew": []}
        self.write()

    def note(self, msg):
        self.record["crew"].append(msg)

    def write(self):
        try:
            fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                json.dump(self.record, f, indent=1, default=str)
                f.write("\n")
        except OSError as e:
            print(f"[crew] debug capture failed: {e}", file=sys.stderr)


capture = None          # set in main() when debugging is switched on


def debug_dir():
    """Where to capture hook payloads, or None when debugging is off."""
    override = os.environ.get("CREW_DEBUG_DIR")
    d = Path(override).expanduser() if override else DEBUG_DIR
    return d if d.is_dir() else None


def git(*args, cwd=None, check=True, capture=True):
    r = subprocess.run(["git", *args], cwd=cwd, text=True,
                       capture_output=capture, check=False)
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} failed: {(r.stderr or '').strip()}")
    return (r.stdout or "").strip()


def main_checkout(cwd):
    """Path of the main (non-linked) checkout for the repo containing cwd."""
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=cwd)
    return Path(common).parent.resolve()


def repo_name(main):
    return main.name


def ws_root(main):
    override = os.environ.get("AGENT_WS_ROOT")
    if override:
        return Path(override).expanduser().resolve()
    parent = main.parent
    if os.access(parent, os.W_OK):
        return parent
    fallback = Path.home() / ".claude" / "workspaces"
    fallback.mkdir(parents=True, exist_ok=True)
    return fallback


def ws_path(main, agent):
    return ws_root(main) / f"{repo_name(main)}.{agent}"


def safe_slug(s):
    s = re.sub(r"[^a-zA-Z0-9._-]+", "-", s).strip("-.")
    return s[:48] or "task"


def current_branch(path):
    return git("rev-parse", "--abbrev-ref", "HEAD", cwd=path)


def is_dirty(path):
    return bool(git("status", "--porcelain", "--untracked-files=all", cwd=path))


def branch_base(path, branch):
    return git("config", "--get", f"branch.{branch}.agent-base", cwd=path, check=False)


def set_branch_base(path, branch, base):
    git("config", f"branch.{branch}.agent-base", base, cwd=path)


def is_merged(path, branch, base):
    if not base or not git("rev-parse", "--verify", "-q", base, cwd=path, check=False):
        return False
    return subprocess.run(["git", "merge-base", "--is-ancestor", branch, base],
                          cwd=path, capture_output=True).returncode == 0


def resolve_base(main, base_ref):
    """Turn the hook's base_ref into (branch_name, sha) in the main checkout."""
    head_branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=main)
    if base_ref in ("", None, "head", "HEAD"):
        return head_branch, git("rev-parse", "HEAD", cwd=main)
    if base_ref == "fresh":
        origin = git("symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD", cwd=main, check=False)
        if origin and git("rev-parse", "--verify", "-q", origin, cwd=main, check=False):
            return origin, git("rev-parse", origin, cwd=main)
        return head_branch, git("rev-parse", "HEAD", cwd=main)
    sha = git("rev-parse", "--verify", "-q", base_ref, cwd=main, check=False)
    if sha:
        return base_ref, sha
    return head_branch, git("rev-parse", "HEAD", cwd=main)


def branch_exists(main, branch):
    return bool(git("rev-parse", "--verify", "-q", f"refs/heads/{branch}", cwd=main, check=False))


def new_branch_name(main, agent):
    base_name = f"{BRANCH_PREFIX}{agent}/{datetime.now().strftime('%Y%m%d-%H%M')}"
    name, i = base_name, 2
    while branch_exists(main, name):
        name, i = f"{base_name}-{i}", i + 1
    return name


def task_slug(text):
    return re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-")[:40].rstrip("-")


def free_task(main, agent, task, keep=None):
    """`task`, or task-2, task-3..., whichever has neither a workspace nor a branch yet.
    `keep` is a branch that is already this workspace's own, so it is not in the way."""
    name, i = task, 2
    while ws_path(main, f"{agent}.{name}").exists() or (
            f"{BRANCH_PREFIX}{agent}/{name}" != keep and branch_exists(main, f"{BRANCH_PREFIX}{agent}/{name}")):
        name, i = f"{task}-{i}", i + 1
    return name


@contextmanager
def locked(main):
    """One hook at a time per repo: agents launched together ask for worktrees together,
    and each has to see which launch the others have already taken."""
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=main)
    with open(Path(common) / "crew.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


# ----------------------------------------------------------------------------- launches
def pending_launches(transcript):
    """Agent tool calls in a session transcript that have no result yet, oldest first.

    WorktreeCreate fires while the launch is in flight: the call is already in the
    transcript and its result is not. The transcript format is not documented, so
    anything unexpected means no launches, and the caller falls back."""
    try:
        with open(os.path.expanduser(transcript), "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - TRANSCRIPT_TAIL))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except (OSError, TypeError):
        return []
    calls, done = [], set()
    for line in lines:
        if '"tool_use"' not in line and '"tool_result"' not in line:
            continue
        try:
            content = json.loads(line)["message"]["content"]
        except Exception:
            continue                                # a partial first line, or another shape
        for block in content if isinstance(content, list) else []:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "tool_use" and block.get("name") in ("Agent", "Task"):
                calls.append(block)
            elif block.get("type") == "tool_result":
                done.add(block.get("tool_use_id"))
    return [c for c in calls if c.get("id") and c["id"] not in done]


def wants_worktree(call, cwd):
    """Does this launch get a worktree? Only those can be what WorktreeCreate is for."""
    args = call.get("input") or {}
    if args.get("isolation") == "worktree":
        return True
    for d in (Path(cwd) / ".claude" / "agents", Path.home() / ".claude" / "agents"):
        try:
            frontmatter = (d / f"{args.get('subagent_type')}.md").read_text().split("---")[1]
        except (OSError, IndexError):
            continue
        return bool(re.search(r"^isolation:\s*worktree\s*$", frontmatter, re.MULTILINE))
    return False


def claimed_launches(main):
    out = git("config", "--get-regexp", r"^branch\..*\.agent-launch$", cwd=main, check=False)
    return {line.split()[-1] for line in out.splitlines() if line.strip()}


def match_launch(calls, taken, payload):
    """The launch among `calls` that this worktree is for, as (agent, task, launch id),
    or None.

    When the payload names the call (`tool_use_id`, in Claude Code releases newer than
    2.1.287) that is the one, and nothing else is considered. Otherwise agents launched
    in the same message are taken in the order they were written. That is a guess when
    there are several, which is why SubagentStop checks it."""
    wanted = payload.get("tool_use_id")
    for call in calls:
        if wanted and call["id"] != wanted:
            continue
        args = call.get("input") or {}
        agent = safe_slug(args.get("subagent_type") or "")
        if call["id"] in taken or not args.get("subagent_type") or agent in IN_CHECKOUT_AGENTS:
            continue
        if wanted or wants_worktree(call, payload.get("cwd") or os.getcwd()):
            return agent, task_slug(args.get("description")) or datetime.now().strftime("%Y%m%d-%H%M"), call["id"]
    return None


def next_launch(main, payload):
    """(launch, seconds waited): the launch this worktree is for, see match_launch, or
    None when the transcript does not show one.

    Claude Code writes the transcript behind the conversation, and WorktreeCreate fires
    within milliseconds of the Agent call, so the call is usually not on disk yet when
    the hook starts (in 2.1.287: the whole launch returns within a second of the call's
    timestamp). Keep re-reading for LAUNCH_WAIT; the lock is held meanwhile, so agents
    launched together still claim their calls one at a time, in order."""
    transcript = payload.get("transcript_path")
    if not transcript:
        return None, 0.0
    taken = claimed_launches(main)
    started = time.monotonic()
    while True:
        launch = match_launch(pending_launches(transcript), taken, payload)
        waited = time.monotonic() - started
        if launch or waited >= LAUNCH_WAIT:
            return launch, waited
        time.sleep(LAUNCH_POLL)


def launch_record(payload):
    """What Claude Code noted about this agent's launch: its description, and the id of
    the call that launched it. Kept beside the agent's transcript; not documented, so
    fall back to the description in the payload, and then to nothing."""
    try:
        meta = Path(os.path.expanduser(payload["agent_transcript_path"])).with_suffix(".meta.json")
        return json.loads(meta.read_text())
    except Exception:
        pass
    for task in payload.get("background_tasks") or []:
        if isinstance(task, dict) and task.get("id") == payload.get("agent_id"):
            return {"description": task.get("description")}
    return {}


def copy_worktreeinclude(main, dest):
    inc = main / ".worktreeinclude"
    if not inc.exists():
        return
    patterns = [l.strip() for l in inc.read_text().splitlines() if l.strip() and not l.startswith("#")]
    if not patterns:
        return
    ignored = git("ls-files", "--others", "--ignored", "--exclude-standard", cwd=main).splitlines()
    import fnmatch, shutil
    for rel in ignored:
        if any(fnmatch.fnmatch(rel, p) or fnmatch.fnmatch(Path(rel).name, p) or rel.startswith(p.rstrip("/") + "/")
               for p in patterns):
            src, dst = main / rel, dest / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
            log(f"copied {rel} (from .worktreeinclude)")


def summarize(payload):
    lines = (payload.get("last_assistant_message") or "").strip().splitlines()
    return re.sub(r"\s+", " ", lines[0])[:72] if lines else "end of run"


def workspace_name(p):
    """Directory suffix for a NEW workspace.

    Deliberately does not read `agent_type`. At WorktreeCreate that field holds the
    *calling* session's agent -- the orchestrator that spawned the subagent -- not the
    agent being created, so keying off it drops every delegated agent into the
    orchestrator's own workspace. Observed payload:

        {"agent_type": "orchestrator", "name": "agent-a671a08082793dbaa", ...}

    `name` is the only per-invocation identifier available: "agent-<agent_id>" for a
    subagent, or the given name for EnterWorktree / `claude --worktree`. In Claude Code
    2.1.287 the payload is exactly the common fields plus `name`; the hooks reference
    now also lists `description` and `tool_use_id`, which newer releases send. The real
    agent type is in the payload only at SubagentStop; before that it has to be read
    from the launch in the transcript (see next_launch)."""
    return p.get("name") or "worktree"


def worktrees(main):
    """(path, branch) for each linked worktree of the repo; branch is "" when detached."""
    out = []
    for block in git("worktree", "list", "--porcelain", cwd=main).split("\n\n"):
        wt = dict(l.split(" ", 1) for l in block.splitlines() if " " in l)
        p = Path(wt.get("worktree", ""))
        if "worktree" in wt and p != main and p.is_dir():
            out.append((p, wt.get("branch", "").replace("refs/heads/", "")))
    return out


def branch_agent(branch):
    """The agent a branch belongs to: agent/<agent>/<stamp> -> <agent>, anything else ''."""
    parts = branch.split("/")
    return parts[1] if len(parts) >= 3 and branch.startswith(BRANCH_PREFIX) else ""


def find_workspace(cwd, agent):
    """(path, branch) of the workspace `agent` most recently worked in, given any cwd
    inside the repo or a workspace. The branch, agent/<agent>/..., is what says whose
    workspace it is, whatever the directory is called."""
    if agent in IN_CHECKOUT_AGENTS:
        raise SystemExit(f"{agent} works in your checkout and has no workspace; "
                         f"find its commits with: git log -F --grep '[{agent}]'")
    main = main_checkout(cwd)
    mine = [(p, br) for p, br in worktrees(main) if branch_agent(br) == agent]
    if not mine:
        raise SystemExit(f"no workspace for '{agent}'")
    return max(mine, key=lambda w: int(git("log", "-1", "--format=%ct", w[1], cwd=main, check=False) or 0))


# ----------------------------------------------------------------------------- hooks
def hook_create(payload):
    cwd = payload.get("cwd") or os.getcwd()
    main = main_checkout(cwd)
    with locked(main):
        path = create_workspace(main, payload)
    print(path)  # stdout = the worktree path Claude Code will use as cwd
    return 0


def create_workspace(main, payload):
    agent = safe_slug(workspace_name(payload))
    path = ws_path(main, agent)
    base_branch, base_sha = resolve_base(main, payload.get("base_ref"))
    launch, waited = next_launch(main, payload) if GENERATED_NAME.fullmatch(agent) else (None, 0.0)

    if launch:
        agent, task, launch_id = launch
        task = free_task(main, agent, task)
        path, branch = ws_path(main, f"{agent}.{task}"), f"{BRANCH_PREFIX}{agent}/{task}"
        git("worktree", "add", str(path), "-b", branch, base_sha, cwd=main)
        set_branch_base(path, branch, base_branch)
        git("config", f"branch.{branch}.agent-launch", launch_id, cwd=path)
        log(f"created {path} on {branch} (base {base_branch}); "
            f"launch {launch_id} was in the transcript after {waited:.1f}s")
    elif not path.exists():
        branch = new_branch_name(main, agent)
        git("worktree", "add", str(path), "-b", branch, base_sha, cwd=main)
        set_branch_base(path, branch, base_branch)
        log(f"created {path} on {branch} (base {base_branch}); could not tell which agent "
            f"it is for after waiting {waited:.1f}s for the transcript, so it is named when the agent stops")
    else:
        # Only a worktree with a fixed name gets here (EnterWorktree, `claude --worktree`);
        # a subagent's name is new on every run. Carry on where it left off -- unless that
        # branch has already landed, in which case start a new one from where you are now
        # rather than building on a stale copy.
        cur = current_branch(path)
        if not is_dirty(path) and is_merged(path, cur, branch_base(path, cur)):
            branch = new_branch_name(main, agent)
            git("checkout", "-q", "-b", branch, base_sha, cwd=path)
            set_branch_base(path, branch, base_branch)
            log(f"reusing {path}: new branch {branch} (base {base_branch})")
        else:
            log(f"reusing {path}: continuing {cur}")
    copy_worktreeinclude(main, path)
    return path


def commit_leftovers(path, agent, summary):
    """Commit whatever is uncommitted in `path`. Returns True if there was anything."""
    if not is_dirty(path):
        return False
    git("add", "-A", cwd=path)
    git("commit", "-q", "-m", f"[{agent}] {summary}", cwd=path)
    return True


def stop_in_checkout(cwd, agent, summary):
    """An agent that works in the human's checkout: commit what it left so there is a
    boundary readable with plain git log/diff.

    This sweeps up everything uncommitted in the tree, the human's own in-flight edits
    included — the agent's prompt tells it to say so up front if the tree starts dirty.
    A clean tree gets no commit, so the human's own commits are never attributed to it."""
    try:
        top = Path(git("rev-parse", "--show-toplevel", cwd=cwd))
    except RuntimeError:
        return 0  # not in a repo; nothing to commit
    if commit_leftovers(top, agent, summary):
        log(f"committed in your checkout on {current_branch(top)} "
            f"({git('rev-parse', '--short', 'HEAD', cwd=top)})")
    return 0


def adopt_branch(path, branch, agent):
    """Give the branch the name it should have had.

    WorktreeCreate builds the branch name from the payload it gets, and for a subagent
    that payload carries a generated id, not the agent type -- so branches start life as
    agent/agent-<id>/<stamp>. SubagentStop *does* know the type, so rename once here."""
    want = f"{BRANCH_PREFIX}{agent}/"
    if branch.startswith(want):
        return branch
    stamp = branch.rsplit("/", 1)[-1]
    name, i = f"{want}{stamp}", 2
    while git("rev-parse", "--verify", "-q", f"refs/heads/{name}", cwd=path, check=False):
        name, i = f"{want}{stamp}-{i}", i + 1
    base = branch_base(path, branch)
    git("branch", "-m", branch, name, cwd=path)
    if base:
        set_branch_base(path, name, base)
    log(f"renamed {branch} -> {name}")
    return name


def settle(main, path, branch, agent, launch):
    """Give a workspace the names it should have had from the start: branch
    agent/<agent>/<task> and directory <repo>.<agent>.<task>. Returns (path, branch).

    Only for a workspace crew had to name blind, or named after the wrong launch. The
    directory moves, so an agent that is later resumed by id will not find the old path."""
    slug = branch.rsplit("/", 1)[-1]
    if branch_agent(branch) == agent and not STAMP.fullmatch(slug):
        task = free_task(main, agent, slug, keep=branch)       # the agent named its branch
    else:
        task = free_task(main, agent, task_slug(launch.get("description")) or slug)
    want = f"{BRANCH_PREFIX}{agent}/{task}"
    if branch != want:
        base = branch_base(path, branch)
        git("branch", "-m", branch, want, cwd=path)
        if base:
            set_branch_base(path, want, base)
    new_path = ws_path(main, f"{agent}.{task}")
    git("worktree", "move", str(path), str(new_path), cwd=main)
    log(f"{path.name} -> {new_path.name} on {want}")
    return new_path, want


def hook_stop(payload):
    # This hook commits and renames branches, so it acts only on a payload that names
    # both the agent and its working directory. No guessing, no os.getcwd() fallback:
    # a malformed payload must be a no-op, not a commit in whatever repo we are in.
    agent_type = (payload.get("agent_type") or "").strip()
    cwd = payload.get("cwd")
    if not agent_type or not cwd or not Path(cwd).is_dir():
        log("stop: payload does not identify an agent and cwd; doing nothing")
        return 0
    agent = safe_slug(agent_type)
    summary = summarize(payload)
    if agent in IN_CHECKOUT_AGENTS:
        return stop_in_checkout(cwd, agent, summary)
    # Locate the worktree the agent actually ran in from its cwd. Do NOT rebuild the
    # path from the agent name: WorktreeCreate does not know the agent type, so the
    # workspace is not necessarily named <repo>.<agent>.
    try:
        main = main_checkout(cwd)
        path = Path(git("rev-parse", "--show-toplevel", cwd=cwd))
    except RuntimeError:
        return 0  # not in a repo
    if path == main:
        return 0  # ran in the human's checkout, not a workspace: leave it alone
    branch = current_branch(path)
    if not branch.startswith(BRANCH_PREFIX):
        return 0
    commit_leftovers(path, agent, summary)
    with locked(main):
        launch = launch_record(payload)
        labelled = git("config", "--get", f"branch.{branch}.agent-launch", cwd=path, check=False)
        blind = bool(GENERATED_NAME.fullmatch(path.name[len(repo_name(main)) + 1:]))
        wrong = bool(labelled and launch.get("toolUseId") and labelled != launch["toolUseId"])
        if blind or wrong:
            path, branch = settle(main, path, branch, agent, launch)
            if launch.get("toolUseId"):
                git("config", f"branch.{branch}.agent-launch", launch["toolUseId"], cwd=path)
        else:
            branch = adopt_branch(path, branch, agent)
    log(f"{agent} finished on {branch} ({git('rev-parse', '--short', 'HEAD', cwd=path)})")
    return 0


def hook_remove(payload):
    # Never remove the workspace. Only drop a branch that has no work on it.
    cwd = payload.get("cwd") or os.getcwd()
    # This payload carries neither `name` nor a usable agent_type -- only paths -- so
    # the workspace is identified directly rather than rebuilt from an agent name.
    path = Path(payload.get("worktree_path") or cwd)
    if not path.is_dir():
        return 0
    try:
        main = main_checkout(path)
    except RuntimeError:
        return 0
    if path == main:
        return 0  # never prune anything in the human's checkout
    branch = current_branch(path)
    base = branch_base(path, branch)
    if branch.startswith(BRANCH_PREFIX) and base and not is_dirty(path):
        base_sha = git("rev-parse", "--verify", "-q", base, cwd=path, check=False)
        if base_sha and git("rev-parse", "HEAD", cwd=path) == base_sha:
            git("checkout", "-q", "--detach", cwd=path)
            git("branch", "-D", branch, cwd=path)
            log(f"pruned empty branch {branch}; workspace kept at {path}")
    return 0


# ----------------------------------------------------------------------------- CLI
def cmd_list(_):
    main = main_checkout(os.getcwd())
    prefix = f"{repo_name(main)}."
    rows = []
    for p, br in worktrees(main):
        if not p.name.startswith(prefix):
            continue
        agent = branch_agent(br) or p.name[len(prefix):]
        base = branch_base(p, br) if br else ""
        ahead = git("rev-list", "--count", f"{base}..{br}", cwd=p, check=False) if base else "?"
        behind = git("rev-list", "--count", f"{br}..{base}", cwd=p, check=False) if base else "?"
        dirty = "*" if is_dirty(p) else ""
        rows.append((agent, (br or "(detached)") + dirty, base, f"+{ahead}/-{behind}", str(p)))
    if not rows:
        print("no agent workspaces yet")
        return 0
    hdr = ("AGENT", "BRANCH", "BASE", "AHEAD/BEHIND", "PATH")
    widths = [max(len(r[i]) for r in [hdr, *rows]) for i in range(len(hdr))]
    for r in [hdr, *rows]:
        print("  ".join(c.ljust(widths[i]) for i, c in enumerate(r)))
    print("\n* = uncommitted changes in the workspace")
    return 0


def cmd_path(args):
    if len(args) != 1:
        raise SystemExit("usage: crew path <agent>")
    print(find_workspace(os.getcwd(), args[0])[0])
    return 0


def cmd_diff(args):
    if len(args) not in (1, 2):
        raise SystemExit("usage: crew diff <agent> [branch]")
    path, branch = find_workspace(os.getcwd(), args[0])
    against = args[1] if len(args) == 2 else branch_base(path, branch)
    if not against:
        raise SystemExit(f"{branch} has no recorded base; name one: crew diff {args[0]} <branch>")
    # From where the two diverged to the workspace as it stands now, so this is what a
    # merge would bring in -- including anything not committed yet.
    fork = git("merge-base", against, "HEAD", cwd=path, check=False)
    if not fork:
        raise SystemExit(f"cannot compare {branch} with '{against}': no such branch, or no shared history")
    print(f"# {branch} against {against}, uncommitted changes included", file=sys.stderr)
    subprocess.run(["git", "diff", "--stat", fork], cwd=path)
    subprocess.run(["git", "diff", fork], cwd=path)
    untracked = git("ls-files", "--others", "--exclude-standard", cwd=path)
    if untracked:
        print(f"\n# new files git is not tracking yet, so not in the diff above:\n{untracked}")
    return 0


def only_here(path, branch):
    """How many of the workspace's commits removing it would lose: those on no branch
    that stays behind. None when git cannot say.

    Other agent/ branches do not count as staying behind. They may be removed in the
    same sweep, and two workspaces at the same commit would otherwise vouch for each
    other. A branch of any other name is not deleted, so it loses nothing."""
    if branch and not branch.startswith(BRANCH_PREFIX):
        return 0
    out = git("rev-list", "--count", branch or "HEAD", "--not", f"--exclude={BRANCH_PREFIX}*",
              "--branches", "--remotes", cwd=path, check=False)
    return int(out) if out.isdigit() else None


def cmd_clean(args):
    everything = "--all" in args
    names = [a for a in args if a != "--all"]
    if len(names) > 1 or any(a.startswith("-") for a in names):
        raise SystemExit("usage: crew clean [--all] [<agent>]")
    main = main_checkout(os.getcwd())
    here = Path(os.getcwd()).resolve()
    prefix = f"{repo_name(main)}."

    remove, keep = [], []
    for p, br in worktrees(main):
        if not p.name.startswith(prefix):
            continue
        if names and (branch_agent(br) or p.name[len(prefix):]) != names[0]:
            continue
        unmerged = only_here(p, br)
        at_stake = []
        if unmerged is None:
            at_stake.append("cannot tell whether its commits are anywhere else")
        elif unmerged:
            at_stake.append(f"{unmerged} commit{'s' if unmerged > 1 else ''} on no other branch")
        if is_dirty(p):
            at_stake.append("uncommitted changes")
        if here == p.resolve() or p.resolve() in here.parents:
            keep.append((p, br, "you are in it"))
        elif at_stake and not everything:
            keep.append((p, br, ", ".join(at_stake)))
        else:
            remove.append((p, br, ", ".join(at_stake)))

    def show(title, rows, note):
        if rows:
            width = max(len(p.name) for p, _, _ in rows)
            print(title)
            for p, br, why in rows:
                print(f"  {p.name.ljust(width)}  {br or '(detached)'}" + (f"  — {note}{why}" if why else ""))

    show("keeping:", keep, "")
    show("removing:", remove, "LOSES ")
    if not remove:
        print("nothing to remove" + (" (crew clean --all removes the ones kept)" if keep else ""))
        return 0
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("\nnothing removed: run this yourself at a terminal to confirm")
        return 0
    lost = sum(1 for _, _, why in remove if why)
    ask = f"\nRemove {len(remove)} workspace{'s' if len(remove) > 1 else ''}"
    ask += f", {lost} of them with work that exists nowhere else" if lost else ""
    if input(f"{ask}? [y/N] ").strip().lower() not in ("y", "yes"):
        print("nothing removed")
        return 0

    failed = 0
    for p, br, _ in remove:
        try:
            git("worktree", "remove", *(["--force"] if everything else []), str(p), cwd=main)
            if br.startswith(BRANCH_PREFIX):
                git("branch", "-D", br, cwd=main)
            print(f"removed {p.name}")
        except RuntimeError as e:
            failed += 1
            print(f"could not remove {p.name}: {e}", file=sys.stderr)
    for link in ws_root(main).glob(f"{prefix}*"):       # shortcuts left by older versions
        if link.is_symlink() and not link.exists():
            link.unlink()
    git("worktree", "prune", cwd=main, check=False)
    return 1 if failed else 0


HELP_FLAGS = {"help", "-h", "--help"}


def main():
    cmd, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else (None, [])
    if cmd is None or cmd in HELP_FLAGS:
        print(__doc__.strip())  # asking for help is not an error
        return 0
    if cmd.startswith("hook-"):
        global capture
        try:
            payload = json.load(sys.stdin)
        except Exception:
            payload = {}
        debug = debug_dir()
        if debug:
            capture = Capture(debug, cmd, payload)
        try:
            return {"hook-create": hook_create, "hook-stop": hook_stop, "hook-remove": hook_remove}[cmd](payload)
        except Exception as e:  # never let a hook crash silently
            log(f"error: {e}")
            return 1 if cmd == "hook-create" else 0
        finally:
            if capture:
                capture.write()
    table = {"list": cmd_list, "path": cmd_path, "diff": cmd_diff, "clean": cmd_clean}
    if cmd not in table:
        print(f"crew: unknown subcommand '{cmd}'\n"
              f"       valid: {', '.join(table)}\n"
              f"       try 'crew help' for usage", file=sys.stderr)
        return 2
    return table[cmd](args)


if __name__ == "__main__":
    sys.exit(main())
