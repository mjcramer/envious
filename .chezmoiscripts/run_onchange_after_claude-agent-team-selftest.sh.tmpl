#!/usr/bin/env bash
# Self-test for the Claude Code agent team. Runs after `chezmoi apply` whenever any of the
# files below change (the hashes make this script's content — and therefore its run — change).
#
# guard-infra.py:       {{ include "dot_claude/hooks/executable_guard-infra.py" | sha256sum }}
# crew:                 {{ include "dot_claude/bin/executable_crew" | sha256sum }}
# settings.json:        {{ include "dot_claude/settings.json" | sha256sum }}
# CLAUDE.md:            {{ include "dot_claude/CLAUDE.md" | sha256sum }}
set -uo pipefail

CLAUDE_DIR="{{ .chezmoi.homeDir }}/.claude"
fail=0
# Colour only the labels, and only on a terminal with NO_COLOR unset (https://no-color.org),
# so chezmoi logs and pipes get plain text. The escapes are zero-width, so columns hold.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  GREEN=$'\033[32m' RED=$'\033[31m' RESET=$'\033[0m'
else
  GREEN='' RED='' RESET=''
fi
ok()   { printf '  %sOKAY%s  %s\n' "$GREEN" "$RESET" "$1"; }
bad()  { printf '  %sFAIL%s  %s\n' "$RED" "$RESET" "$1"; fail=1; }

echo "claude agent-team self-test"

# 1. prerequisites
command -v python3 >/dev/null && ok "python3 present" || bad "python3 missing (hooks and crew need it)"
command -v git     >/dev/null && ok "git present"     || bad "git missing"

# 2. settings.json is valid JSON and carries the hooks
if python3 - "$CLAUDE_DIR/settings.json" <<'PY'
import json, sys
s = json.load(open(sys.argv[1]))
h = s.get("hooks", {})
need = {"PreToolUse": "guard-infra.py", "WorktreeCreate": "hook-create",
        "WorktreeRemove": "hook-remove", "SubagentStop": "hook-stop"}
missing = [e for e, frag in need.items()
           if not any(frag in hk.get("command", "") for m in h.get(e, []) for hk in m.get("hooks", []))]
sys.exit(1 if missing else 0)
PY
then ok "settings.json valid, all four hooks wired"; else bad "settings.json missing hooks or invalid"; fi

# 3. agents present
for a in orchestrator system-designer craft-engineer spike-engineer infra-engineer \
         hardware-engineer security-reviewer incident-responder; do
  [ -f "$CLAUDE_DIR/agents/$a.md" ] && ok "agent $a" || bad "agent $a missing"
done

# 4. guard hook classifies correctly
guard() { printf '{"tool_name":"Bash","tool_input":{"command":"%s"}}' "$1" | python3 "$CLAUDE_DIR/hooks/guard-infra.py"; }
guard "terraform destroy"                 | grep -q '"deny"' && ok "guard denies terraform destroy" || bad "guard did not deny terraform destroy"
guard "kubectl --context prod-w apply -f x" | grep -q '"ask"' && ok "guard asks on prod kubectl"   || bad "guard did not ask on prod kubectl"
[ -z "$(guard 'terraform plan')" ]                            && ok "guard allows terraform plan"   || bad "guard blocked terraform plan"
guard "crew clean --all"                  | grep -q '"deny"' && ok "guard denies crew clean"        || bad "guard did not deny crew clean"

# 5. crew's CLI contract: exit code and which stream the output lands on.
#    Load-bearing because Claude Code reads hook-create's stdout as the agent's working
#    directory — anything else printed there would silently misplace every subagent.
CREW="$CLAUDE_DIR/bin/crew"
T="$(mktemp -d)"                     # everything the crew checks touch stays inside $T
trap 'rm -rf "$T"' EXIT
OUT="$T/out"; ERR="$T/err"
run_crew() { python3 "$CREW" "$@" >"$OUT" 2>"$ERR"; rc=$?; }

[ -x "$CREW" ] && ok "crew is executable" || bad "crew is not executable"

for a in "" help -h --help; do
  run_crew ${a:+"$a"}
  if [ "$rc" -eq 0 ] && [ ! -s "$ERR" ] && grep -q 'git workspaces for Claude Code subagents' "$OUT"; then
    ok "crew ${a:-(no args)} prints usage on stdout, exit 0"
  else
    bad "crew ${a:-(no args)} gave rc=$rc (want 0, usage on stdout, stderr empty)"
  fi
done

run_crew nonesuch
if [ "$rc" -eq 2 ] && [ ! -s "$OUT" ] && grep -q "unknown subcommand 'nonesuch'" "$ERR"; then
  ok "crew <unknown> errors on stderr, exit 2"
else
  bad "crew <unknown> gave rc=$rc (want 2, message on stderr, stdout empty)"
fi

# 6. crew's hooks, end to end on a scratch repo under $T. The payloads are the shape Claude
#    Code really sends: at WorktreeCreate `name` is a generated id and `agent_type` is the
#    *calling* session's agent. So crew reads the agent and the task from the launch that
#    is in flight in the session transcript, and names the workspace <repo>.<agent>.<task>.
R="$T/repo"; WSR="$T/ws"             # scratch repo and its workspace root
AGENT_ID=agent-a671a08082793dbaa     # synthetic; the id shape a subagent arrives with
# crew commits without setting an identity, so give its git subprocesses one
export GIT_AUTHOR_NAME=selftest GIT_AUTHOR_EMAIL=selftest@localhost
export GIT_COMMITTER_NAME=selftest GIT_COMMITTER_EMAIL=selftest@localhost
mkdir -p "$R"
git -C "$R" init -q -b main . && git -C "$R" commit -q --allow-empty -m init

# run_crew_hook <hook-subcommand> <payload-json> [process-cwd, default: the scratch repo]
run_crew_hook() {
  printf '%s' "$2" | (cd "${3:-$R}" && AGENT_WS_ROOT="$WSR" python3 "$CREW" "$1") >"$OUT" 2>"$ERR"; rc=$?
}

# A session transcript with one launch in flight: its Agent call is written, its result
# is not. The earlier launch has its result, so it is not the one being asked about.
TRANSCRIPT="$T/session.jsonl"
cat >"$TRANSCRIPT" <<'JSONL'
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_earlier","name":"Agent","input":{"subagent_type":"infra-engineer","description":"An earlier task","isolation":"worktree","prompt":"x"}}]}}
{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"toolu_earlier","content":"launched"}]}}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_selftest","name":"Agent","input":{"subagent_type":"craft-engineer","description":"Fix the Widget!","isolation":"worktree","prompt":"x"}}]}}
JSONL

run_crew_hook hook-create \
  "$(printf '{"cwd":"%s","base_ref":"head","agent_type":"orchestrator","name":"%s","transcript_path":"%s"}' "$R" "$AGENT_ID" "$TRANSCRIPT")"
WS="$(cat "$OUT")"
if [ "$rc" -eq 0 ] && [ "$(wc -l <"$OUT")" -eq 1 ] && [ -d "$WS" ] && [ "$(basename "$WS")" = "repo.craft-engineer.fix-the-widget" ]; then
  ok "hook-create names the workspace <repo>.<agent>.<task> ($(basename "$WS")), path alone on stdout"
else
  bad "hook-create gave rc=$rc, $(wc -l <"$OUT" | tr -d ' ') line(s) on stdout: $(tr '\n' ' ' <"$OUT")(want just <...>/repo.craft-engineer.fix-the-widget)"
fi
[ -d "$WS" ] || WS="$T/no-workspace"   # keep the checks below inside $T even if that failed

[ "$(git -C "$WS" branch --show-current 2>/dev/null)" = "agent/craft-engineer/fix-the-widget" ] \
  && ok "hook-create branches agent/craft-engineer/fix-the-widget" \
  || bad "hook-create made branch '$(git -C "$WS" branch --show-current 2>/dev/null)' (want agent/craft-engineer/fix-the-widget)"

echo scratch > "$WS/note.txt"
run_crew_hook hook-stop \
  "$(printf '{"cwd":"%s","agent_type":"craft-engineer","last_assistant_message":"selftest run"}' "$WS")"
[ "$rc" -eq 0 ] && [ ! -s "$OUT" ] \
  && ok "hook-stop keeps stdout empty, exit 0" \
  || bad "hook-stop gave rc=$rc and $(wc -c <"$OUT" | tr -d ' ') bytes on stdout (want 0 and 0)"

[ -d "$WS" ] && [ "$(git -C "$WS" branch --show-current 2>/dev/null)" = "agent/craft-engineer/fix-the-widget" ] \
  && ok "hook-stop leaves a workspace that was named at creation where it is" \
  || bad "hook-stop moved or renamed a workspace that already had its name"

git -C "$WS" log --oneline -1 2>/dev/null | grep -qF '[craft-engineer] selftest run' \
  && ok "hook-stop commits what the agent left in the workspace" \
  || bad "hook-stop did not commit the workspace's leftovers"

# When the transcript does not give the launch away, the workspace starts out under the
# generated id and gets its name when the agent stops, which is when the payload says
# who it was and what it was doing.
BLIND_ID=agent-b772b19193804ecbb
run_crew_hook hook-create \
  "$(printf '{"cwd":"%s","base_ref":"head","agent_type":"orchestrator","name":"%s"}' "$R" "$BLIND_ID")"
BLIND="$(cat "$OUT")"
[ "$rc" -eq 0 ] && [ -d "$BLIND" ] && [ "$(basename "$BLIND")" = "repo.$BLIND_ID" ] \
  && ok "hook-create falls back to the generated name without a transcript" \
  || bad "hook-create gave rc=$rc, '$(cat "$OUT")' (want <...>/repo.$BLIND_ID)"
[ -d "$BLIND" ] || BLIND="$T/no-workspace"

run_crew_hook hook-stop \
  "$(printf '{"cwd":"%s","agent_type":"infra-engineer","agent_id":"b772","last_assistant_message":"done","background_tasks":[{"id":"b772","description":"Rotate the logs"}]}' "$BLIND")"
NAMED="$WSR/repo.infra-engineer.rotate-the-logs"
[ "$rc" -eq 0 ] && [ ! -s "$OUT" ] && [ -d "$NAMED" ] && [ ! -e "$BLIND" ] \
  && [ "$(git -C "$NAMED" branch --show-current 2>/dev/null)" = "agent/infra-engineer/rotate-the-logs" ] \
  && ok "hook-stop names a blind workspace repo.infra-engineer.rotate-the-logs" \
  || bad "hook-stop gave rc=$rc and did not move repo.$BLIND_ID to repo.infra-engineer.rotate-the-logs"

# The CLI finds an agent's workspace from its branch name. Ask from the main checkout.
( cd "$R" && AGENT_WS_ROOT="$WSR" python3 "$CREW" path craft-engineer ) >"$OUT" 2>"$ERR"; rc=$?
[ "$rc" -eq 0 ] && [ "$(cd "$(cat "$OUT")" 2>/dev/null && pwd -P)" = "$(cd "$WS" && pwd -P)" ] \
  && ok "crew path finds craft-engineer's workspace from its branch" \
  || bad "crew path craft-engineer gave rc=$rc, '$(cat "$OUT")' (want $WS)"

( cd "$R" && AGENT_WS_ROOT="$WSR" python3 "$CREW" list ) >"$OUT" 2>"$ERR"; rc=$?
[ "$rc" -eq 0 ] && grep -q '^craft-engineer  *agent/craft-engineer/' "$OUT" \
  && ok "crew list names the workspace's agent from its branch" \
  || bad "crew list gave rc=$rc and did not list craft-engineer"

# crew diff is the preview: committed and uncommitted work alike, against the base the
# workspace was cut from by default, or against a branch named on the command line.
echo edited >> "$WS/note.txt"; echo new > "$WS/draft.txt"
git -C "$R" branch other
for against in "" other; do
  ( cd "$R" && AGENT_WS_ROOT="$WSR" python3 "$CREW" diff craft-engineer ${against:+"$against"} ) >"$OUT" 2>"$ERR"; rc=$?
  [ "$rc" -eq 0 ] && grep -q '^+scratch$' "$OUT" && grep -q '^+edited$' "$OUT" && grep -q '^draft.txt$' "$OUT" \
    && ok "crew diff craft-engineer ${against:-(base)} shows committed, uncommitted and new work" \
    || bad "crew diff craft-engineer ${against:-(base)} gave rc=$rc without the expected changes"
done
git -C "$WS" checkout -q -- note.txt; rm -f "$WS/draft.txt"

run_crew_hook hook-remove "$(printf '{"cwd":"%s","worktree_path":"%s"}' "$R" "$WS")"
[ "$rc" -eq 0 ] && [ ! -s "$OUT" ] && [ -d "$WS" ] \
  && ok "hook-remove keeps the workspace, stdout empty, exit 0" \
  || bad "hook-remove gave rc=$rc (want 0, stdout empty, workspace kept)"

echo scratch > "$R/scratch.py"
run_crew_hook hook-stop \
  "$(printf '{"cwd":"%s","agent_type":"spike-engineer","last_assistant_message":"selftest"}' "$R")"
git -C "$R" log --oneline -1 2>/dev/null | grep -qF '[spike-engineer] selftest' \
  && ok "crew commits spike-engineer's finish in the checkout" \
  || bad "crew did not commit spike-engineer's finish in the checkout"

# A payload naming no agent must be a no-op, not a commit in whatever repo we happen to be
# in. Run it from inside the workspace with the tree dirty: that is where a fallback to
# os.getcwd() or to a default agent_type would actually commit and rename something.
echo stray > "$WS/stray.txt"
HEAD_BEFORE="$(git -C "$WS" rev-parse HEAD)"
BRANCH_BEFORE="$(git -C "$WS" branch --show-current)"
run_crew_hook hook-stop '{}' "$WS"
[ "$rc" -eq 0 ] && [ ! -s "$OUT" ] \
  && [ "$(git -C "$WS" rev-parse HEAD)" = "$HEAD_BEFORE" ] \
  && [ "$(git -C "$WS" branch --show-current)" = "$BRANCH_BEFORE" ] \
  && ok "hook-stop ignores a payload that names no agent" \
  || bad "hook-stop acted on a payload with no agent_type (rc=$rc)"

# crew clean removes workspaces, so it only acts when a person answers yes at a terminal.
# At this point the craft-engineer workspace holds an unmerged commit and a stray file;
# the infra-engineer one holds nothing that is not already on main.
( cd "$R" && AGENT_WS_ROOT="$WSR" python3 "$CREW" clean --all ) >"$OUT" 2>"$ERR" </dev/null; rc=$?
[ "$rc" -eq 0 ] && grep -q 'nothing removed' "$OUT" && [ -d "$WS" ] && [ -d "$NAMED" ] \
  && ok "crew clean removes nothing without a terminal" \
  || bad "crew clean acted without a terminal (rc=$rc)"

# answer_crew <answer> <crew args...>: run crew at a terminal of its own and type the answer
answer_crew() {
  AGENT_WS_ROOT="$WSR" python3 - "$CREW" "$R" "$@" >"$OUT" 2>"$ERR" <<'PY'
import os, pty, sys
crew, repo, answer, *args = sys.argv[1:]
pid, fd = pty.fork()
if pid == 0:
    os.chdir(repo)
    os.execvp("python3", ["python3", crew, *args])
seen, sent = b"", False
while True:
    try:
        chunk = os.read(fd, 4096)
    except OSError:
        break
    if not chunk:
        break
    seen += chunk
    if not sent and b"[y/N]" in seen:
        os.write(fd, answer.encode() + b"\n")
        sent = True
sys.stdout.write(seen.decode(errors="replace"))
sys.exit(os.WEXITSTATUS(os.waitpid(pid, 0)[1]))
PY
  rc=$?
}

answer_crew y clean
[ "$rc" -eq 0 ] && [ ! -e "$NAMED" ] && [ -d "$WS" ] \
  && ! git -C "$R" rev-parse -q --verify refs/heads/agent/infra-engineer/rotate-the-logs >/dev/null \
  && ok "crew clean removes the merged workspace and its branch, keeps the unmerged one" \
  || bad "crew clean gave rc=$rc; wanted repo.infra-engineer.rotate-the-logs gone and $(basename "$WS") kept"

answer_crew n clean --all
[ "$rc" -eq 0 ] && [ -d "$WS" ] \
  && ok "crew clean --all removes nothing when the answer is no" \
  || bad "crew clean --all removed a workspace after a no (rc=$rc)"

answer_crew y clean --all
[ "$rc" -eq 0 ] && [ ! -e "$WS" ] \
  && ! git -C "$R" rev-parse -q --verify refs/heads/agent/craft-engineer/fix-the-widget >/dev/null \
  && [ -z "$(git -C "$R" worktree list --porcelain | grep -c '^worktree ' | grep -v '^1$')" ] \
  && ok "crew clean --all removes every workspace and agent branch" \
  || bad "crew clean --all gave rc=$rc and left workspaces or branches behind"

# 7. PATH hint (informational only)
case ":$PATH:" in
  *":$CLAUDE_DIR/bin:"*) ok "~/.claude/bin on PATH" ;;
  *) echo "  note  add ~/.claude/bin to PATH to run 'crew' directly" ;;
esac

if [ "$fail" -ne 0 ]; then
  echo "claude agent-team self-test: FAILED (chezmoi apply already wrote the files; fix and re-run 'chezmoi apply')"
  exit 1
fi
echo "claude agent-team self-test: all good — restart any running 'claude' session and run /agents"
