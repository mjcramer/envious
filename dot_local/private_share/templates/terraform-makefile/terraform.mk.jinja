{% if provider == "gcp" %}
REQUIRED_TOOLS := terraform gcloud gsutil
GCP_ACCOUNT ?= {{ owner_account }}

# Macro for outputting ASCII color
define color
\033[${1}m${2}\033[0m
endef

terraform_modules := $(addprefix {{ project_name }}-, {{ components }})
terraform_files := $(wildcard *.tf)
terraform_files += $(foreach module, ${terraform_modules}, $(wildcard ../modules/${module}/*.tf))
terraform_plan := {{ project_name }}-${COMPONENT}.plan
terraform_state := .terraform
terraform_state_bucket := {{ project_name }}-terraform
terraform_encryption_keyring_name := ${COMPONENT}-keys
terraform_encryption_key_name := terraform-encryption
terraform_encryption_key_version := latest

.PHONY: check
check: ## Check required tools, variables, and credentials
	@for exec in $(REQUIRED_TOOLS); do \
		command -v "$$exec" >/dev/null 2>&1 || { printf 'Required command not found: %s\n' "$$exec" >&2; exit 1; }; \
	done
	@test -n "$(GCP_BILLING_ACCOUNT)" || { printf 'GCP_BILLING_ACCOUNT is undefined\n' >&2; exit 1; }
	@test -n "$(GCP_PROJECT_ID)" || { printf 'GCP_PROJECT_ID is undefined\n' >&2; exit 1; }
	@test -n "$(GCP_REGION)" || { printf 'GCP_REGION is undefined\n' >&2; exit 1; }
	@test -n "$(COMPONENT)" || { printf 'COMPONENT is undefined\n' >&2; exit 1; }
	@printf "# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #\n"
	@printf "# \n"
	@printf "#  Billing account: $(call color,91;1,$(GCP_BILLING_ACCOUNT))\n"
	@printf "#  Project:         $(call color,94;1,$(GCP_PROJECT_ID))\n"
	@printf "#  Region:          $(call color,95;1,$(GCP_REGION))\n"
	@printf "#  Component:       $(call color,92;1,$(COMPONENT))\n"
	@printf "# \n"
	@printf "# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #\n"
	@terraform version
	@printf "\n$(call color,97;1,Checking gcloud authentication...)\n"
	@printf "Checking if gcloud is authenticated to an authorized account...\n"
	@test "$$(gcloud config get-value account 2>/dev/null)" = "$(GCP_ACCOUNT)" || { printf 'gcloud is not authenticated as %s\n' "$(GCP_ACCOUNT)" >&2; exit 1; }
	@printf "\n"

.PHONY: project
project: check ## Create google cloud project
	@if gcloud projects describe $(GCP_PROJECT_ID) > /dev/null 2>&1; then \
	  	printf "Project $(GCP_PROJECT_ID) already created\n"; \
	else \
		printf "Creating project $(GCP_PROJECT_ID)...\n"; \
		gcloud projects create $(GCP_PROJECT_ID); \
	fi
	@printf "Linking billing account $(GCP_BILLING_ACCOUNT) to project $(GCP_PROJECT_ID)...\n"
	@gcloud beta billing projects link $(GCP_PROJECT_ID) --billing-account $(GCP_BILLING_ACCOUNT)
	@printf "Enabling key management and cloud storage...\n"
	@gcloud services enable cloudkms.googleapis.com storage.googleapis.com --project ${GCP_PROJECT_ID}

.PHONY: encryption
encryption: check ## Create encryption keys for terraform
	@if gcloud kms keyrings describe $(terraform_encryption_keyring_name) \
			--project $(GCP_PROJECT_ID) --location $(GCP_REGION) > /dev/null 2>&1; then \
	  	printf "Key ring $(terraform_encryption_keyring_name) already created\n"; \
	else \
		printf "Creating key ring $(terraform_encryption_keyring_name)...\n"; \
		gcloud kms keyrings create $(terraform_encryption_keyring_name) \
			--project $(GCP_PROJECT_ID) --location $(GCP_REGION); \
	fi
	@if gcloud kms keys describe $(terraform_encryption_key_name) \
			--project $(GCP_PROJECT_ID) --location $(GCP_REGION) \
			--keyring $(terraform_encryption_keyring_name) > /dev/null 2>&1; then \
	  	printf "Key $(terraform_encryption_key_name) already created\n"; \
	else \
		printf "Creating key $(terraform_encryption_key_name)...\n"; \
		gcloud kms keys create $(terraform_encryption_key_name) \
			--project $(GCP_PROJECT_ID) --location $(GCP_REGION) \
			--keyring $(terraform_encryption_keyring_name) \
			--purpose encryption; \
	fi

.PHONY: storage
storage: gcp_project_number = $(shell gcloud projects describe $(GCP_PROJECT_ID) --format="value(projectNumber)")
storage: check ## Create storage for terraform backend
	@if gcloud storage buckets describe gs://$(terraform_state_bucket)/ --format="value(name)" > /dev/null 2>&1; then \
		printf "Storage bucket $(terraform_state_bucket) already exists.\n"; \
	else \
		printf "Creating storage bucket $(terraform_state_bucket)...\n"; \
		gsutil mb \
			-l $(GCP_REGION) \
			-p $(GCP_PROJECT_ID) \
			gs://$(terraform_state_bucket)/; \
	fi
	@printf "Configuring bucket access...\n"
	@gsutil ubla set on gs://$(terraform_state_bucket)/
	@gcloud storage buckets update gs://$(terraform_state_bucket)/ \
	  --default-encryption-key projects/$(GCP_PROJECT_ID)/locations/$(GCP_REGION)/keyRings/$(terraform_encryption_keyring_name)/cryptoKeys/$(terraform_encryption_key_name)
	@gcloud kms keys add-iam-policy-binding $(terraform_encryption_key_name) \
  		--keyring=$(terraform_encryption_keyring_name) \
  		--location=$(GCP_REGION) \
  		--member=serviceAccount:service-$(gcp_project_number)@gs-project-accounts.iam.gserviceaccount.com \
  		--role=roles/cloudkms.cryptoKeyEncrypterDecrypter
	@gcloud storage buckets add-iam-policy-binding gs://$(terraform_state_bucket)/ \
	  	--member="user:$(GCP_ACCOUNT)" \
  		--role="roles/storage.objectViewer"

${terraform_state}:
	printf "Initializing terraform state...\n"
	@terraform init

.PHONY: init
init: cleaner check ## Initialize terraform
	printf "Initializing terraform with upgrade...\n"
	@terraform init -upgrade

.PHONY: reinit
reinit: check ## Initializes terraform with the same encryption key (does not get from google)
	@terraform init -upgrade -migrate-state

.PHONY: clean
clean: ## Remove old terraform plan, if one exists
	@if [ -e "${terraform_plan}" ]; then \
	  printf "Removing old terraform plan at $(CURDIR)/${terraform_plan}...\n" ;\
	  rm -f ${terraform_plan} ;\
	fi

.PHONY: cleaner
cleaner: clean ## Remove all traces of terraform execution, subsequent commands will require re-init
	@if [ -d "${terraform_state}" ]; then \
	  printf "Removing terraform state at $(CURDIR)/${terraform_state}...\n" ;\
	  rm -rf ${terraform_state} ;\
	fi

.PHONY: format
format: check
	@printf "Formatting files...\n"
	@terraform fmt ${terraform_files}

%.plan: check ${terraform_state} ${terraform_files}
	@printf "Creating terraform plan...\n"
	@terraform plan -out $@

.PHONY: plan
plan: check ${terraform_plan} ## Generate terraform plan

.PHONY: unplan
unplan: check
	@terraform plan -destroy

.PHONY: apply
apply: check ${terraform_plan} ## Generate terraform plan (if necessary) and apply
	@printf "Applying terraform plan...\n"
	@terraform apply ${terraform_opts} ${terraform_plan}
	@printf "Plan successfully applied, deleting old plan...\n"
	@rm -f ${terraform_plan}

.PHONY: destroy
destroy: check clean ## Destroy all resources created by terraform
	@printf "Destroying all terraform resources...\n"
	@terraform destroy -auto-approve

.PHONY: output
output: check ## Display terraform output
	@terraform output -json
{% elif provider == "aws" %}

REQUIRED_TOOLS := terraform aws
AWS_REGION ?= $(AWS_DEFAULT_REGION)
AWS_OWNER_ACCOUNT_ID ?= {{ owner_account }}
AWS_TERRAFORM_BUCKET ?= $(COMPONENT)-terraform-state
AWS_KMS_ALIAS ?= alias/$(COMPONENT)-terraform-encryption
AWS_EKS_CLUSTER_NAME ?= $(COMPONENT)

terraform_modules := $(addprefix {{ project_name }}-, {{ components }})
terraform_files := $(wildcard *.tf)
terraform_files += $(foreach module, ${terraform_modules}, $(wildcard ../modules/${module}/*.tf))
terraform_plan := {{ project_name }}-${COMPONENT}.plan
terraform_state := .terraform
terraform_encryption_key_name := $(AWS_KMS_ALIAS)

.PHONY: check
check: ## Check required tools, variables, and AWS credentials
	@for exec in $(REQUIRED_TOOLS); do \
		command -v "$$exec" >/dev/null 2>&1 || { printf 'Required command not found: %s\n' "$$exec" >&2; exit 1; }; \
	done
	@test -n "$(AWS_REGION)" || { printf 'AWS_REGION is undefined\n' >&2; exit 1; }
	@test -n "$(COMPONENT)" || { printf 'COMPONENT is undefined\n' >&2; exit 1; }
	@current_account="$$(aws sts get-caller-identity --query Account --output text --region "$(AWS_REGION)")"; \
	test "$$current_account" = "$(AWS_OWNER_ACCOUNT_ID)" || { printf 'AWS credentials belong to account %s, expected %s\n' "$$current_account" "$(AWS_OWNER_ACCOUNT_ID)" >&2; exit 1; }
	@printf "# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #\n"
	@printf "# \n"
	@printf "#  Account:   $(AWS_OWNER_ACCOUNT_ID)\n"
	@printf "#  Region:    $(AWS_REGION)\n"
	@printf "#  Component: $(COMPONENT)\n"
	@printf "# \n"
	@printf "# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #\n"
	@terraform version

.PHONY: project
project: check ## Display the current AWS account
	@aws sts get-caller-identity --query '{Account:Account,Arn:Arn}' --output table --region "$(AWS_REGION)"

.PHONY: encryption
encryption: check ## Create the KMS key used to encrypt Terraform state
	@if aws kms describe-key --key-id "$(AWS_KMS_ALIAS)" --region "$(AWS_REGION)" >/dev/null 2>&1; then \
		printf "KMS key $(AWS_KMS_ALIAS) already exists.\n"; \
	else \
		key_id="$$(aws kms create-key --description "Terraform encryption for $(COMPONENT)" --query KeyMetadata.KeyId --output text --region "$(AWS_REGION)")"; \
		aws kms create-alias --alias-name "$(AWS_KMS_ALIAS)" --target-key-id "$$key_id" --region "$(AWS_REGION)"; \
		printf "Created KMS key $(AWS_KMS_ALIAS).\n"; \
	fi

.PHONY: storage
storage: check encryption ## Create and configure the S3 Terraform state bucket
	@if aws s3api head-bucket --bucket "$(AWS_TERRAFORM_BUCKET)" --region "$(AWS_REGION)" >/dev/null 2>&1; then \
		printf "S3 bucket $(AWS_TERRAFORM_BUCKET) already exists.\n"; \
	else \
		if [ "$(AWS_REGION)" = "us-east-1" ]; then \
			aws s3api create-bucket --bucket "$(AWS_TERRAFORM_BUCKET)" --region "$(AWS_REGION)"; \
		else \
			aws s3api create-bucket --bucket "$(AWS_TERRAFORM_BUCKET)" --region "$(AWS_REGION)" --create-bucket-configuration LocationConstraint="$(AWS_REGION)"; \
		fi; \
	fi
	@aws s3api put-public-access-block --bucket "$(AWS_TERRAFORM_BUCKET)" --region "$(AWS_REGION)" --public-access-block-configuration BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
	@aws s3api put-bucket-versioning --bucket "$(AWS_TERRAFORM_BUCKET)" --region "$(AWS_REGION)" --versioning-configuration Status=Enabled
	@key_arn="$$(aws kms describe-key --key-id "$(AWS_KMS_ALIAS)" --query KeyMetadata.Arn --output text --region "$(AWS_REGION)")"; \
	aws s3api put-bucket-encryption --bucket "$(AWS_TERRAFORM_BUCKET)" --region "$(AWS_REGION)" --server-side-encryption-configuration "Rules=[{ApplyServerSideEncryptionByDefault={SSEAlgorithm=aws:kms,KMSMasterKeyID=$$key_arn}}]"

${terraform_state}:
	@printf "Initializing terraform state...\n"
	@terraform init

.PHONY: init
init: cleaner check ## Initialize terraform
	@printf "Initializing terraform with upgrade...\n"
	@terraform init -upgrade

.PHONY: reinit
reinit: check ## Reinitialize Terraform and migrate existing state
	@terraform init -upgrade -migrate-state

.PHONY: clean
clean: ## Remove the generated Terraform plan
	@if [ -e "${terraform_plan}" ]; then \
		printf "Removing old terraform plan at $(CURDIR)/${terraform_plan}...\n"; \
		rm -f "${terraform_plan}"; \
	fi

.PHONY: cleaner
cleaner: clean ## Remove Terraform state and the generated plan
	@if [ -d "${terraform_state}" ]; then \
		printf "Removing terraform state at $(CURDIR)/${terraform_state}...\n"; \
		rm -rf "${terraform_state}"; \
	fi

.PHONY: format
format: check
	@printf "Formatting files...\n"
	@terraform fmt ${terraform_files}

%.plan: check ${terraform_state} ${terraform_files}
	@printf "Creating terraform plan...\n"
	@terraform plan -out "$@"

.PHONY: plan
plan: check ${terraform_plan} ## Generate terraform plan

.PHONY: unplan
unplan: check
	@terraform plan -destroy

.PHONY: apply
apply: check ${terraform_plan} ## Generate terraform plan (if necessary) and apply
	@printf "Applying terraform plan...\n"
	@terraform apply ${terraform_opts} ${terraform_plan}
	@printf "Plan successfully applied, deleting old plan...\n"
	@rm -f ${terraform_plan}

.PHONY: destroy
destroy: check clean ## Destroy all resources created by terraform
	@printf "Destroying all resources created by terraform...\n"
	@terraform destroy -auto-approve

.PHONY: output
output: check ## Display terraform output
	@terraform output -json
{% else %}
{% endif %}
