#!/usr/bin/env bash

# run_onchange_, not run_once_: this owns two derived artefacts (the key and
# allowed_signers) and both steps are idempotent, so re-running is free. It also
# means a change to .email -- which is baked into the rendered script, and so
# into its content hash -- re-runs this and refreshes the allowed_signers
# principal. run_once_ would leave a stale principal behind on such a host.

set -euo pipefail
echo "==> chezmoi: $(basename "${BASH_SOURCE[0]}")"
prefix="[setup ssh identity]"
echo

key="$HOME/.ssh/id_ed25519"
pubkey="$key.pub"
allowed_signers="$HOME/.ssh/allowed_signers"

if [ ! -f "$key" ]; then
    echo "$prefix Generating ed25519 key..."
    ssh-keygen -t ed25519 -C {{ .email | quote }} -f "$key" -N ""
    echo "$prefix SSH key generated at $key"
    echo "$prefix Public key:"
    cat "$pubkey"
    echo ""
else
    echo "$prefix SSH key already exists at $key"
fi

# allowed_signers is what lets `git log --show-signature` verify locally; git's
# gpg.ssh.allowedSignersFile points at it. Fully regenerated rather than merged:
# it holds exactly one principal, and merging would be more machinery than the
# problem deserves. Extra principals added by hand will be overwritten.
if [ ! -f "$pubkey" ]; then
    # Visible and recoverable rather than fatal: the private key still works for
    # auth and for signing, only local verification is degraded. A later apply
    # picks this up once the pubkey is restored (ssh-keygen -y -f "$key").
    echo "$prefix WARNING: $pubkey is missing, skipping $allowed_signers."
    echo "$prefix WARNING: signature verification will find no matching principal."
else
    line="{{ .email }} $(cat "$pubkey")"
    if [ -f "$allowed_signers" ] && [ "$(cat "$allowed_signers")" = "$line" ]; then
        echo "$prefix $allowed_signers already up to date"
    else
        printf '%s\n' "$line" > "$allowed_signers"
        chmod 644 "$allowed_signers"
        echo "$prefix Wrote $allowed_signers"
    fi
fi
